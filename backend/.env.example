PORT=3030
HTTP_PORT=3030
HTTP_BIND_HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=offerpilot
DB_USER=root
DB_PASSWORD=
USE_MOCK_INTERVIEW_PROVIDER=0
ALLOW_PUBLIC_HTTP_BIND=0
INTERVIEW_PROVIDER=remote
INTERVIEW_REMOTE_VENDOR=aliyun-bailian
INTERVIEW_REMOTE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
INTERVIEW_REMOTE_MODEL=qwen3.6-plus
INTERVIEW_REMOTE_API_KEY=
# qwen3.6-plus 默认开启思考模式，响应较慢；面试反馈建议 false（快速模式）
INTERVIEW_REMOTE_ENABLE_THINKING=false
INTERVIEW_STORAGE_DIR=data
AUTH_TOKEN_SECRET=offerpilot-admin-secret
DEMO_USER_USERNAME=user
DEMO_USER_PASSWORD=user
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin
