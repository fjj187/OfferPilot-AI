# OfferPilot C++ 后端 Linux 生产环境示例
# 请将真实内容放到 /etc/offerpilot/backend.env

HTTP_PORT=3030
HTTP_BIND_HOST=127.0.0.1
ALLOW_PUBLIC_HTTP_BIND=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=offerpilot
DB_USER=offerpilot_app
DB_PASSWORD=请替换为真实密码

USE_MOCK_INTERVIEW_PROVIDER=0
AUTH_TOKEN_TTL_SECONDS=86400

OPENAI_API_KEY=请替换为真实API密钥
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_INTERVIEW_MODEL=gpt-4o-mini
OPENAI_REPORT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000

# 可选：如果需要显式指定环境文件路径，可通过服务启动前设置
# OFFERPILOT_ENV_FILE=/etc/offerpilot/backend.env
